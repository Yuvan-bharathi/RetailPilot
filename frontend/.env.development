# Development defaults (not secret). The Phase 6 API exists, so the dev server talks to FastAPI on :8000 through the
# Vite proxy. Set VITE_USE_MOCKS=true (e.g. in .env.development.local) to work on the UI without the backend; the
# mock client serves fixtures exported from the synthetic data (scripts/export_mock_fixtures.py).
VITE_USE_MOCKS=false
