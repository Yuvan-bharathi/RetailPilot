    +incoming: int
    +in_transit_out: int
    +created_at: datetime
    +updated_at: datetime
  }
  class InventoryMovement as "inventory_movement" {
    +movement_id: UUID <<PK>>
    +occurred_at: datetime <<PK>>
    +business_date: date
    +store_id: UUID <<FK>>
    +product_id: UUID <<FK>>
    +batch_id: UUID <<FK>>
