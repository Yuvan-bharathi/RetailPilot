  class InventoryDailySnapshot as "inventory_daily_snapshot" {
    +store_id: UUID <<PK,FK>>
    +product_id: UUID <<PK,FK>>
    +snapshot_date: date <<PK>>
    +shelf_qty: int
    +backroom_qty: int
    +closing_on_hand: int
    +created_at: datetime
    +updated_at: datetime
  }
}

