@startuml erd
!include style.iuml
skinparam linetype ortho
title RetailPilot AI — Entity Relationship Diagram (ERD)\n<size:11>Generated from SQLAlchemy models (app.domain.models)</size>
hide empty methods

package "Master Data" as MD {
  class Store as "store" {
    +store_id: UUID <<PK>>
    +code: str(16)
    +name: str
    +region: str
    +store_type: str
    +location_context: JSONB
    +display_capacity: int
    +created_at: datetime
    +updated_at: datetime
  }
  class Product as "product" {
    +product_id: UUID <<PK>>
    +sku: str(64)
    +name: str
    +category: str
    +brand: str
    +cost_price: Decimal
    +selling_price: Decimal
    +pack_size: int
    +shelf_life_days: int
    +created_at: datetime
    +updated_at: datetime
  }
  class StoreProduct as "store_product" {
    +store_id: UUID <<PK,FK>>
    +product_id: UUID <<PK,FK>>
    +preferred_supplier_id: UUID <<FK>>
    +min_display_qty: int
    +safety_stock_days: int
    +review_period_days: int
    +abc_class: str(1)
    +xyz_class: str(1)
    +is_listed: bool
    +created_at: datetime
    +updated_at: datetime
  }
  class Supplier as "supplier" {
    +supplier_id: UUID <<PK>>
    +name: str
    +default_lead_time_days: int
    +is_active: bool
    +created_at: datetime
    +updated_at: datetime
  }
  class SupplierProduct as "supplier_product" {
    +supplier_id: UUID <<PK,FK>>
    +product_id: UUID <<PK,FK>>
    +price: Decimal
    +lead_time_days: int
    +moq: int
    +order_pack_size: int
    +created_at: datetime
    +updated_at: datetime
  }
  class SupplierStoreTerms as "supplier_store_terms" {
    +supplier_id: UUID <<PK,FK>>
    +store_id: UUID <<PK,FK>>
    +lead_time_days: int
    +delivery_charge: Decimal
    +created_at: datetime
    +updated_at: datetime
  }
  class CalendarEvent as "calendar_event" {
    +event_id: UUID <<PK>>
    +event_date: date
    +event_type: str
    +region: str
    +description: str
    +created_at: datetime
    +updated_at: datetime
  }
}

package "Sales" as S {
  class SalesTransaction as "sales_transaction" {
    +bill_id: UUID <<PK>>
    +store_id: UUID <<FK>>
    +txn_datetime: datetime
    +txn_date: date
    +total_amount: Decimal
    +created_at: datetime
    +updated_at: datetime
  }
  class SalesLine as "sales_line" {
    +bill_id: UUID <<PK,FK>>
    +line_no: int <<PK>>
    +txn_date: date <<PK>>
    +store_id: UUID <<FK>>
    +product_id: UUID <<FK>>
    +qty: int
    +unit_price: Decimal
    +discount: Decimal
    +is_return: bool
    +is_voided: bool
    +is_promo_day: bool
    +created_at: datetime
    +updated_at: datetime
  }
}

