# Copy to .env (git-ignored). Values here are local-development defaults only.
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL (used by infra/docker-compose.yml and the backend)
POSTGRES_USER=retailpilot
POSTGRES_PASSWORD=retailpilot
POSTGRES_DB=retailpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://retailpilot:retailpilot@localhost:5432/retailpilot

# Redis (Celery broker + cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# LLM (explanations only; deterministic templates are used when the key is empty)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=["http://localhost:5173"]
