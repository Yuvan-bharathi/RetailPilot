# Copy to .env (git-ignored). Values here are local-development defaults only.
APP_ENV=local
LOG_LEVEL=INFO

# PostgreSQL (used by infra/docker-compose.yml and the backend)
POSTGRES_USER=retailpilot
POSTGRES_PASSWORD=retailpilot
POSTGRES_DB=retailpilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://retailpilot:retailpilot@localhost:5432/retailpilot

# Redis (Celery broker + cache)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# LLM provider (D-53): anthropic (default) | groq | template. Numbers always come from the evidence and tools;
# without the provider's key (or with LLM_PROVIDER=template) templates and the agents' deterministic paths are used.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
# Groq (optional second provider): OpenAI open-weight models
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

APP_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=["http://localhost:5173"]
